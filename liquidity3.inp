clear 
open C:\_Work\ML\AggregatedProfits\2026.11.06.txt
setobs 1 1 --special-time-series

series d_flow = (BUYSELL == "BUY") ? QTY : -QTY
series d_flow_sign = d_flow != 0 ? d_flow / abs(d_flow) : 0

scalar AGGR_WINDOW = 10
scalar STEP = 1
scalar REGRESS_WINDOW = 50

series sells
series buys

# --- Aggregation of d_flow_sign ---
series d_flow_sign_sum_series = 0/0
scalar d_flow_sign_sum = 0
scalar cnt = 0
scalar buy_sum = 0
scalar sell_sum = 0
loop i=1..$nobs --quiet
    if (cnt == AGGR_WINDOW)
        d_flow_sign_sum_series[i-1] = d_flow_sign_sum
        sells[i-1] = sell_sum
        buys[i-1] = buy_sum

        d_flow_sign_sum = d_flow_sign[i]        
        cnt = 1
        buy_sum = d_flow_sign[i] == 1 ? 1 : 0
        sell_sum = d_flow_sign[i] == -1 ? -1 : 0
    else
        cnt++
        
        d_flow_sign_sum += d_flow_sign[i]
        buy_sum += (d_flow_sign[i] == 1 ? 1 : 0)
        sell_sum += (d_flow_sign[i] == -1 ? -1 : 0)
    endif
endloop
if $nobs > 0
    d_flow_sign_sum_series[$nobs] = d_flow_sign_sum
endif
# ------------------------------------------
smpl ok(d_flow_sign_sum_series) == 1 --restrict --permanent
d_flow_sign = d_flow_sign_sum_series

series cumflowSign = cum(d_flow_sign)
diff PRICE

# --- Permutation Entropy Calculation ---
series perm_entropy_series
foreign language=R --send-data
	# Base R implementation to avoid dependency issues and improve speed
	data_vec <- gretldata[,"d_flow_sign"]
	m <- 4
	W <- 150 # рекомендуется >= 5 * m!
	n <- length(data_vec)
	pe_results <- rep(0, n)

	# --- Exponential weighting of pattern counters ---
	# The counter of each pattern inside the window is multiplied by
	# exp(-PE_LAMBDA * age), where age is the number of observations
	# between the last point of the pattern and the end of the window
	# (the newest pattern has age 0, the oldest has age W-m).
	# This makes the entropy react faster to recent changes in the
	# pattern structure. Half-life of a pattern's weight: ln(2)/PE_LAMBDA.
	# PE_LAMBDA = 0 reproduces the classic equal-weight permutation entropy.
	LAMBDA <- 2 / (50 + 1) # скорость экспоненциального затухания весов счетчиков паттернов в пермутационной энтропии (0 = равные веса).
							# Здесь 50 - эквивалентная длина окна для сравнения с равновзвешенной энтропией.
							# Значение (здесь 50) должно быть не больше W, иначе чистота экспоненциального взвешивания понижается (при слишком большом значении стремимся к равновзвешенной энтропии - см. выше)
	
	if (n >= W) {
		# Pre-calculate permutations for all segments of length m
		segments <- embed(data_vec, m)
		perms <- apply(segments, 1, function(s) paste(order(s), collapse = ""))
		
		# Normalization factor: log2(m!)
		norm_factor <- log2(factorial(m))
		
		# Exponential weights, aligned with the window layout:
		# the oldest pattern (age W-m) first, the newest (age 0) last.
		age_span <- W - m
		exp_weights <- exp(-LAMBDA * age_span:0)
		total_weight <- sum(exp_weights)
		
		# Calculate rolling (recency-weighted) entropy
		for (i in W:n) {
			# The window ends at index i. The segments contained are those 
			# starting from i-W+1 up to i-m+1.
			win_perms <- perms[(i-W+1):(i-m+1)]
			# Weighted pattern counters (recent patterns count more)
			wcounts <- tapply(exp_weights, win_perms, sum)
			probs <- wcounts / total_weight
			pe_results[i] <- (-sum(probs * log2(probs))) / norm_factor
		}
	}
	entropy <- as.matrix(pe_results)
	gretl.export(entropy)
	on.exit(closeAllConnections())
end foreign

catch matrix pe_vals = mread("entropy.mat", 1)
if !$error
    perm_entropy_series = pe_vals
endif
# --------------------------------------

diff perm_entropy_series
d_perm_entropy_series[1] = 0

# отрезать первые (W-1) значений, т.к. для них энтропия не посчитана и квантили тоже не могут быть определены
smpl obs >= 150 --restrict --permanent
setobs 1 1 --special-time-series

# --- New series: Quantiles of d_perm_entropy_series ---
series d_perm_entropy_quantile
foreign language=R --send-data
	vec <- gretldata[,"d_perm_entropy_series"]
	f <- ecdf(vec)
	pit_res <- as.matrix(f(vec))

	gretl.export(pit_res)
	on.exit(closeAllConnections())
end foreign
catch matrix pit_vals = mread("pit_res.mat", 1)
if !$error
	d_perm_entropy_quantile = pit_vals
endif
# ------------------------------------------------------

# --- посчитать умный OBV
# при этом и smartOBV и cumflowSign аккумулируются с 0 начиная с отсчета 150, а не с отсчета 0 (см. отрезание выше) 
series smartFlowPart = d_perm_entropy_series < 0 ? (1 - d_perm_entropy_quantile) : 0
d_smartOBV = smartFlowPart * d_flow_sign
smartOBV = cum(d_smartOBV)
cumflowSign -= cumflowSign[1]
# --- of посчитать умный OBV

# --- Rolling Regression ---
series coeffSells
series coeffBuys

loop for (i = REGRESS_WINDOW; i<=$t2; i+= STEP) --quiet
    smpl (obs >= i - REGRESS_WINDOW + 1) && (obs <= i) --restrict --quiet
    #var 0 priceDiff ; numSells(0 to -1) numBuys(0 to -1) --nc
    ols d_PRICE sells buys --quiet
    coeffSells[i] = $coeff[1]
    coeffBuys[i] = $coeff[2]
    smpl full --quiet
    setobs 1 1 --special-time-series
endloop
# --- of Rolling Regression ---

# ========== Средние значения flow, structural breaks of
smpl --full
series avgFlow
series avgFlowUpperEst
series avgFlowLowerEst
genr index

series trend_length
series trend_size

foreign language=R --send-data
	library("cpm")
	res <- processStream(gretldata[,"d_flow_sign"], "Lepage", ARL0=370, startup=100, lambda=NA)
	changePoints <- as.matrix(res$changePoints)
	gretl.export(changePoints)
	on.exit(closeAllConnections())
end foreign
catch matrix changePoints = mread("changePoints.mat", 1)

if !$error
loop i=1..rows(changePoints)+1 --quiet
    if (i == 1)
        smpl obs<=changePoints[i,1] --restrict --quiet
    else
        if (i>rows(changePoints))
            smpl obs>changePoints[i-1,1] --restrict --quiet
        else
            smpl obs>changePoints[i-1,1] && obs <=changePoints[i,1] --restrict --quiet
        endif   
    endif

    setobs 1 1 --special-time-series
    #avgFlow = mean(d_flow_sign)
    
    series idx = index - index[$t1]
    ols cumflowSign 0 idx --quiet
    
    print $nobs
    
    if (i <= rows(changePoints))
        avgFlow = $coeff[1] + $coeff[2] * idx
        
        trend_length[$t2] = $nobs
        trend_size[$t2] = cumflowSign[$t2] - cumflowSign[$t1]

    else        
        # Интервал для наклона (коэффициента idx)
        # Оценка среднего значения d_flow_sign методом Moving Block Bootstrap (MBB) с использованием фактических данных
        
        foreign language=R --send-data
            d <- gretldata[,"d_flow_sign"]
            n <- length(d)
            # Параметры MBB
            M <- 10000          # Количество итераций бутстрапа
            N_LENGTH <- 150     # Длина оцениваемой выборки (должна перекрывать ожидаемую длину трендов)
            L <- max(2, floor(n^(1/3))) # Размер блока (Moving Block size)

            res_lo <- 0; res_hi <- 0 # По умолчанию границы равны среднему
            
            if (n >= L) {
                N <- max(n + 1, N_LENGTH)
                boot_means <- numeric(M)
                for (m in 1:M) {
                    current_sample <- d # в начало генерируемого интервала помещаем текущие данные
                    while (length(current_sample) < N) { # далее дополняем генерируемый интервал методом MBB
                        # Выбираем случайный блок из исходной выборки
                        start_idx <- sample(1:(n - L + 1), 1)
                        block <- d[start_idx:(start_idx + L - 1)]
                        current_sample <- c(current_sample, block)
                    }
                    # Обрезаем до длины N
                    current_sample <- current_sample[1:N]
                    boot_means[m] <- mean(current_sample)
                }
                res_lo <- quantile(boot_means, 0.025)
                res_hi <- quantile(boot_means, 0.975)
            }
            boot_ci <- matrix(c(res_lo, res_hi), nrow = 1)
            gretl.export(boot_ci)
            on.exit(closeAllConnections())
        end foreign
        
        catch matrix boot_ci = mread("boot_ci.mat", 1)

        if !$error
            scalar mn = mean(d_flow_sign)
            scalar slope_lower = boot_ci[1,1]
            scalar slope_upper = boot_ci[1,2]
            #avgFlow = cumflowSign[$t1] + mn * idx
            avgFlowUpperEst = cumflowSign[$t1] + slope_upper * idx
            avgFlowLowerEst = cumflowSign[$t1] + slope_lower * idx
        endif
        
    endif    
    
    smpl full --quiet
    setobs 1 1 --special-time-series
endloop
else
    avgFlow = mean(d_flow_sign)
endif
# ========== of Средние значения flow, structural breaks of

# --- Поиск структурных разрывов d_smartOBV (только по ненулевым значениям !) ---
series avgSmartOBV

series smart_trend_length
series smart_trend_size

foreign language=R --send-data
    library("cpm")
    vec <- gretldata[,"d_smartOBV"]
	STARTUP <- 10
    nz_idx <- which(vec != 0)
    cp <- matrix(nrow=0, ncol=1)
    if (length(nz_idx) > STARTUP) {
        res <- processStream(vec[nz_idx], "Lepage", ARL0=370, startup=STARTUP, lambda=NA)
        cp_raw <- as.matrix(res$changePoints)
        if (nrow(cp_raw) > 0) {
            cp <- nz_idx[cp_raw]
        }
    }
    gretl.export(cp)
    on.exit(closeAllConnections())
end foreign
catch matrix changePoints_smartOBV = mread("changePoints_smartOBV.mat", 1)

if !$error
loop i=1..rows(changePoints_smartOBV)+1 --quiet
    if (i == 1)
        smpl obs<=changePoints_smartOBV[i,1] --restrict --quiet
    else
        if (i>rows(changePoints_smartOBV))
            smpl obs>changePoints_smartOBV[i-1,1] --restrict --quiet
        else
            smpl obs>changePoints_smartOBV[i-1,1] && obs <=changePoints_smartOBV[i,1] --restrict --quiet
        endif   
    endif

    setobs 1 1 --special-time-series
    
    series idx = index - index[$t1]
    ols smartOBV 0 idx --quiet
        
    if (i <= rows(changePoints_smartOBV))
        avgSmartOBV = $coeff[1] + $coeff[2] * idx
        
        smart_trend_length[$t2] = $nobs
        smart_trend_size[$t2] = smartOBV[$t2] - smartOBV[$t1]

    else        
        # Интервал для наклона (коэффициента idx)
        # Оценка среднего значения d_smartOBV
        
        scalar mn = mean(d_smartOBV)        
		avgSmartOBV = smartOBV[$t1] + mn * idx
        
        # avgSmartOBV = $coeff[1] + $coeff[2] * idx
    endif    
    
    smpl full --quiet
    setobs 1 1 --special-time-series
endloop
else
    avgFlow = mean(d_flow_sign)
endif
# --- of Поиск структурных разрывов d_smartOBV  ---

series med_perm_entropy_series = median(perm_entropy_series)

smpl obs > ($t2 - 400/STEP) --restrict

list list1 = coeffSells coeffBuys PRICE
gnuplot list1 --time-series --output=display {set terminal pngcairo size 1600,600; set tics font ", 12"; set ytics 0.001; set yrange[0:0.005]; set xtics 50; set y2tics 0.1; plot '-' using 1:($2) axes x1y1 w lines title "liquidity for sells" lc rgb "red", '-' using 1:($2) axes x1y1 w lines title "liquidity for buys" lc rgb "green", '-' using 1:($2) axes x1y2 w lines title "price" lc rgb "blue";}

list list2 = perm_entropy_series med_perm_entropy_series cumflowSign avgFlow avgFlowUpperEst avgFlowLowerEst
gnuplot list2 --time-series --output=display {set terminal pngcairo size 1600,600; set tics font ", 12"; set ytics 0.1; set yrange[0.7:1]; set xtics 50; set y2tics 100; plot '-' using 1:($2) axes x1y1 w lines title "Permutation Entropy" lc rgb "purple", '-' using 1:($2) axes x1y1 w lines title "Permutation Entropy (median)" lc rgb "purple", '-' using 1:($2) axes x1y2 w lines title "flow" lc rgb "blue", '-' using 1:($2) axes x1y2 w points title "avg flow" lc rgb "blue" pt 7 ps 0.3, '-' using 1:($2) axes x1y2 w points title "avg flow upper est" lc rgb "green" pt 7 ps 0.3, '-' using 1:($2) axes x1y2 w points title "avg flow lower est" lc rgb "red" pt 7 ps 0.3;}

list list3 = smartOBV avgSmartOBV cumflowSign avgFlow avgFlowUpperEst avgFlowLowerEst
gnuplot list3 --time-series --output=display {set terminal pngcairo size 1600,600; set tics font ", 12"; set ytics 100; set xtics 50; set y2tics 100; plot '-' using 1:($2) axes x1y1 w lines title "Smart OBV" lc rgb "magenta", '-' using 1:($2) axes x1y1 w points title "avg Smart OBV" lc rgb "magenta" pt 7 ps 0.3, '-' using 1:($2) axes x1y2 w lines title "flow" lc rgb "blue", '-' using 1:($2) axes x1y2 w points title "avg flow" lc rgb "blue" pt 7 ps 0.3, '-' using 1:($2) axes x1y2 w points title "avg flow upper est" lc rgb "green" pt 7 ps 0.3, '-' using 1:($2) axes x1y2 w points title "avg flow lower est" lc rgb "red" pt 7 ps 0.3;}

smpl full
