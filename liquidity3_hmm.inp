clear 
open C:\_Work\ML\AggregatedProfits\2026.09.25.txt
setobs 1 1 --special-time-series

series d_flow = (BUYSELL == "BUY") ? QTY : -QTY
series d_flow_sign = d_flow != 0 ? d_flow / abs(d_flow) : 0

diff PRICE

series cumflow = cum(d_flow)
series cumflowSign = cum(d_flow_sign)

#smpl obs > 160000 && obs < 161000 && d_flow_sign == -1 --restrict
#setobs 1 1

scalar STEP = 10
scalar REGRESS_WINDOW = 500

series sells = d_flow_sign < 0 ? d_flow_sign : 0
series buys = d_flow_sign > 0 ? d_flow_sign : 0
series volSells = d_flow_sign < 0 ? d_flow : 0
series volBuys = d_flow_sign > 0 ? d_flow : 0

# ========== Средние значения flow, structural breaks of
smpl --full
series avgFlow
genr index

foreign language=R --send-data
	# Установка и загрузка библиотеки
	# install.packages("depmixS4")
	library(depmixS4)
	library(TTR)

	# Путь к файлу параметров (используем прямые слэши для R)
	param_file <- "C:/_Work/ML/AggregatedProfits/USDRUBF_hmm_params.rds"

	# Подготовка данных
	# Допустим, ваш ряд: y <- c(1, 1, -1, -1, 1, -1, ...)
	# Преобразуем в индексы категорий (1 и 2), так как depmixS4 работает с ними
	y_encoded <- as.factor(ifelse(gretldata[,"d_flow_sign"] == -1, 1, 2))
	data_df <- data.frame(val = y_encoded, d_price = gretldata[,"d_PRICE"])

	# Короткая память (последние лагм)
	data_df$lag1 <- c(NA, head(data_df$val, -1))
	data_df$lag2 <- c(NA, NA, head(data_df$val, -2))
	n_lag <- 50
	data_df$lag50 <- c(rep(NA, n_lag), head(data_df$val, -n_lag))	
	n_lag <- 100
	data_df$lag100 <- c(rep(NA, n_lag), head(data_df$val, -n_lag))
	n_lag <- 200
	data_df$lag200 <- c(rep(NA, n_lag), head(data_df$val, -n_lag))

	data_df$d_price_lag1 <- c(NA, head(data_df$d_price, -1))
	data_df$d_price_lag2 <- c(NA, NA, head(data_df$d_price, -2))

	# Среднесрочная инерция (SMA)
	data_df$sma_medium <- SMA(data_df$val, n = 10)
	# Долговременная память (EWMA - очень эффективна!)
	# Параметр n здесь определяет "сглаживание"
	data_df$ewma_long <- EMA(data_df$val, n = 50)
	# Разница (импульс)
	data_df$momentum <- data_df$sma_medium - data_df$ewma_long

	# Удаляем NA, которые возникли из-за лагов
	data_df <- na.omit(data_df)

	# Дообучать ли модель (если TRUE - обучаем заново и пересохраняем параметры)
	do_update_model <- FALSE

	# Определение количества состояний
	n_states <- 3
	
	# Создаем структуру модели
	model <- depmix(
		val ~ lag1 + lag2 + lag50 + lag100 + lag200,
		family = multinomial(),
		nstates = n_states,
		data = data_df,
		instart = c(0.333, 0.334, 0.333),
		trstart = matrix(c(0.998, 0.001, 0.001,
							0.001, 0.998, 0.001,
							0.001, 0.001, 0.998),
							nrow = 3, byrow = TRUE)
	)

	# Если файл с параметрами существует, загружаем только параметры в структуру модели
	if (file.exists(param_file)) {
		pars <- readRDS(param_file)
		model <- setpars(model, pars)
	}

	# Обучение модели (EM-алгоритм). 
    # Если параметры были загружены выше, обучение начнется с них.
	if (do_update_model) { # обновляеи все коэффициенты в модели
		fit_model <- fit(model)
	} else { # НЕ обновляеи все коэффициенты в модели
		all_pars <- getpars(model)
		num_params <- length(all_pars)
		fix_vector <- rep(FALSE, num_params)
		fit_model <- fit(model, fixed = fix_vector)
	}

	# Сохраняем только параметры обученной модели
	if (do_update_model) {
		saveRDS(getpars(fit_model), param_file)
	}


	# 4. Получение результатов: определение скрытых состояний для каждой точки времени
	post_probs <- posterior(fit_model)

	# post_probs$state покажет, в каком режиме находился ряд в каждый момент времени
	# print(post_probs)

	modesProbabilities <- as.matrix(post_probs)
	gretl.export(modesProbabilities)
	on.exit(closeAllConnections())
end foreign
catch matrix modesProbabilities = mread("modesProbabilities.mat", 1)

series regime1
series regime2
series regime3

smpl obs > ($t2-rows(modesProbabilities)) --restrict # отрезаем наблюдения, отрезанные в скрипте R из-за лагов

regime1 = modesProbabilities[,2]
regime2 = modesProbabilities[,3]
regime3 = modesProbabilities[,4]

smpl obs > ($t2 - 2000) --restrict

list list2 = regime1 regime2 regime3 cumflowSign
gnuplot list2 --time-series --output=display {set terminal pngcairo size 1600,600; set ytics 0.1; set yrange[0:1]; set xtics 100; set y2tics 100; plot '-' using 1:($2) axes x1y1 w lines title "regime1" lc rgb "red", '-' using 1:($2) axes x1y1 w lines title "regime2" lc rgb "green", '-' using 1:($2) axes x1y1 w lines title "regime3" lc rgb "black", '-' using 1:($2) axes x1y2 w lines title "flow" lc rgb "blue";}

smpl full
